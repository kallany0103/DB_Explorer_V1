/* Global Application Stylesheet */

* {
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
}

QComboBox {
    combobox-popup: 0;
}

QPushButton[loading="true"],
QPushButton[loading="true"]:disabled {
    background-color: #f0f7ff;
    color: #0284c7;
    border: 1px solid #93c5fd;
}

QSplitter::handle { background: #E4E8ED; border: none; }

/* ── Global Scrollbars ─────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 25px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 25px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QMainWindow, QToolBar { background-color: #ECEFF3; color: #1f2937; }
QStatusBar { background-color: #F2F4F7; color: #1f2937; border-top: 1px solid #D1D6DD; }
QTreeView { background-color: white; alternate-background-color: #F7F8FA; border: 1px solid #E2E8F0; outline: none; }
QTreeView::item { border: none; }
QTreeView::item:selected, QTreeView::item:selected:active, QTreeView::item:selected:!active { background-color: #f0f0f0; color: black; border: none; outline: none; }
QTableView { alternate-background-color: #f7f7f7; background-color: white; gridline-color: #e2e8f0; border: 1px solid #E2E8F0; font-size: 9pt;}
QTableView::item { padding: 4px; }
QTableView::item:selected { background-color: #8E959E; color: white; }
QHeaderView::section {
    background-color: #A9A9A9;
    color: #ffffff;
    padding: 5px;
    border: none;
    border-right: 1px solid #d3d3d3;
    border-bottom: 1px solid #A9A9A9;
    font-weight: 600;
    font-size: 9pt;
}
QHeaderView::section:disabled {
    color: #ffffff;
}

QTreeView QHeaderView::section {
    background-color: #9FA6AF;
    color: #ffffff;
    font-weight: 600;
    border-bottom: 1px solid #8B929B;
    text-align: left;
}

#objectExplorerLabel {
    font-size: 11px;
    font-weight: bold;
    color: #1f2937;
    background-color: transparent;
    border: none;
    padding: 0;
}

#objectExplorerLabel:disabled {
    color: #1f2937;
}

#objectExplorerHeader {
    background-color: #E4E8ED;
    border-bottom: 1px solid #D3D8DF;
}

/* ── Custom title bar ─────────────────────────────────────── */
#titleBar {
    background-color: #F7F8FA;
    border-bottom: 1px solid #D3D8DF;
}

#titleBarIcon {
    background: transparent;
}

#titleBarSpacer {
    background: transparent;
}

#titleBarBtnUser, #titleBarBtnSettings, #titleBarBtnMin, #titleBarBtnMax, #titleBarBtnClose {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}

#titleBarBtnUser:hover, #titleBarBtnSettings:hover, #titleBarBtnMin:hover, #titleBarBtnMax:hover {
    background-color: #DDE2E8;
}

#titleBarBtnClose:hover {
    background-color: #e81123;
}

/* ── Menu bar (embedded inside title bar) ────────────────── */
QMenuBar {
    background-color: transparent;
    border: none;
}

QMenuBar::item {
    background: transparent;
    padding: 7px 10px;
    margin: 0px;
}

QMenuBar::item:selected {
    background-color: #DDE2E8;
    color: #1f2937;
}

QMenuBar::separator {
    width: 0px;
    background: transparent;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #D3D8DF;
    padding: 3px 0px;
}

QMenu#accountMenu {
    background-color: #FFFFFF;
    border: 1px solid #D3D8DF;
    border-radius: 10px;
    padding: 6px 0px;
}

QMenu#accountMenu::item {
    padding: 8px 32px 8px 34px;
}

QMenu#accountMenu::icon {
    padding-left: 12px;
    width: 16px;
    height: 16px;
}

QWidget#accountMenuHeader {
    background: #FFFFFF;
}

QLabel#accountMenuAvatar {
    background: #F1F3F4;
    border-radius: 12px;
}

QLabel#accountMenuTitle {
    color: #202124;
    font-size: 13px;
    font-weight: 600;
}

QLabel#accountMenuSubtitle {
    color: #5F6368;
    font-size: 11px;
}

QMenu::item {
    padding: 4px 24px 4px 6px;
    font-size: 9pt;
    color: #333333;
}

QMenu::icon {
    padding-left: 6px;
    width: 14px;
    height: 14px;
}

QMenu::item:selected {
    background-color: #e8e8e8;
    color: #000000;
}

QMenu::item:disabled {
    color: #a0a8b4;
    background-color: transparent;
}

QTableView QTableCornerButton::section { background-color: #9FA6AF; border: 1px solid #B8BEC6; }
#resultsHeader QPushButton, #editorHeader QPushButton { background-color: #ffffff; border: 1px solid #B8BEC6; padding: 5px 15px; font-size: 9pt; font-weight: 500; }
#resultsHeader QPushButton:hover, #editorHeader QPushButton:hover { background-color: #ECEFF3; }
#resultsHeader QPushButton:checked, #editorHeader QPushButton:checked { background-color: #E2E8F0; border: 1px solid #B8BEC6; border-bottom: 2px solid #60A5FA; padding: 5px 15px 4px 15px; font-weight: 500; color: #1F2937; }
#resultsHeader, #editorHeader { background-color: #ffffff; padding-bottom: 0px; border-bottom: 1px solid #E2E8F0; }
#tab_toolbar, #worksheetTabContent { background-color: #ffffff; }
#tab_toolbar { border-top: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0; }

#tab_toolbar QToolButton { 
    padding: 0px; border: 1px solid #b9b9b9; 
    background-color: #ffffff; border-radius: 4px; 
    font-size: 9pt; color: #333333; 
}
#tab_toolbar QPushButton, #tab_toolbar QComboBox { 
    padding: 2px 8px; border: 1px solid #b9b9b9; 
    background-color: #ffffff; border-radius: 4px; 
    font-size: 9pt; color: #333333; 
}
#tab_toolbar QToolButton:hover, #tab_toolbar QPushButton:hover, #tab_toolbar QComboBox:hover { 
    background-color: #e8e8e8; border-color: #9c9c9c; 
}
#tab_toolbar QToolButton:pressed, #tab_toolbar QPushButton:pressed, #tab_toolbar QComboBox:on { 
    background-color: #dcdcdc; 
}
#tab_toolbar QComboBox::drop-down { 
    border: none; border-left: 1px solid #c6c6c6; 
    width: 24px; 
    border-top-right-radius: 4px; 
    border-bottom-right-radius: 4px; 
}
#tab_toolbar QComboBox::drop-down:hover { 
    background-color: #dcdcdc; 
}
#tab_toolbar QComboBox::down-arrow { 
    image: url(assets/toolbar-chevron-down.svg); 
    width: 10px; height: 10px; 
}
#tab_toolbar QToolButton::menu-indicator,
#tab_toolbar QToolButton::menu-arrow {
    image: url(assets/toolbar-chevron-down.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    margin-right: 7px;
}
#tab_toolbar QToolButton::menu-indicator {
    border: none;
    border-left: none;
}
#tab_toolbar QToolButton::menu-button {
    border: none;
    border-left: none;
    width: 16px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
#tab_toolbar QToolButton::menu-button:hover {
    background-color: #dcdcdc;
}
#messageView, #history_details_view, QTextEdit, QPlainTextEdit { font-family: Consolas, monospace; font-size: 10pt; background-color: white; border: 1px solid #B8BEC6; }
#history_details_view { border-radius: 6px; padding: 8px; }
#history_details_group {
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    margin-top: 8px;
    font-weight: bold;
}
#history_details_group::title {
    subcontrol-origin: margin;
    left: 7px;
    padding: 0 3px 0 3px;
}

#tab_status_label { padding: 3px 5px; background-color: #F7F8FA; border-top: 1px solid #B8BEC6; }

#history_list_view {
    border: 1px solid #d8dce2;
    border-radius: 6px;
    background: #ffffff;
    alternate-background-color: #f7f9fc;
    padding: 4px;
}
#history_list_view::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f0f2f5;
}
#history_list_view::item:selected {
    background: #eaf2ff;
    color: #1f2937;
}

#historyActionContainer QPushButton {
    min-height: 26px;
    padding: 2px 10px;
    border: 1px solid #cfd6df;
    border-radius: 6px;
    background: #ffffff;
    color: #1f2937;
    font-size: 9pt;
}
#historyActionContainer QPushButton:hover {
    background: #f4f7fb;
    border-color: #b8c2cf;
}
#historyActionContainer QPushButton:pressed {
    background: #e9eef5;
}

#resultsInfoBar {
    background-color: transparent;
    border: none;
}
#resultsInfoBar QPushButton {
    min-height: 20px;
    max-height: 20px;
    min-width: 20px;
    max-width: 20px;
    padding: 0px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
    color: #475569;
}
#resultsInfoBar QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
    color: #1E293B;
}
#resultsInfoBar QPushButton:pressed {
    background-color: #E2E8F0;
    border-color: #64748B;
}
#resultsInfoBar QPushButton:disabled {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    color: #CBD5E1;
}
#resultsInfoBar QPushButton#delete_row_btn {
    color: #DC2626;
}
#resultsInfoBar QPushButton#delete_row_btn:hover {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
    color: #B91C1C;
}

#table_search_box {
    min-height: 20px;
    max-height: 20px;
    height: 20px;
    padding: 0px 4px 0px 2px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
    color: #1E293B;
    font-size: 8.5pt;
}
#table_search_box:focus {
    border-color: #3B82F6;
}

#processFilterBar QPushButton {
    border: 1px solid #B8BEC6;
    border-radius: 4px;
    background: #F9FAFB;
    color: #1f2937;
    padding: 2px 8px;
    font-size: 9pt;
    font-weight: 500;
}
#processFilterBar QPushButton:hover {
    background: #E7EBF1;
    border-color: #9FA6AF;
}
#processFilterBar QPushButton:pressed {
    background: #D9DFE8;
}
#processFilterBar QPushButton:checked {
    background: #8E959E;
    border-color: #7A828C;
    color: #ffffff;
    font-weight: 500;
}
#processFilterBar {
    background: #ECEFF3; 
    border-bottom: 1px solid #C9CFD8;
}
#processInfoBar {
    background: transparent; 
    border: none;
}

#explainToolbar {
    background-color: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    max-height: 32px;
}

QPushButton#explainResetBtn {
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 2px 8px;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    background-color: #f9fafb;
    color: #1f2937;
    font-size: 8.5pt;
}
QPushButton#explainResetBtn:hover {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
}
QPushButton#explainResetBtn:pressed {
    background-color: #e5e7eb;
}

QGroupBox { font-size: 9pt; font-weight: bold; color: #1f2937; }
QTabWidget::pane { 
    border: none;
    border-top: 1px solid #C9CFD8;
    background: transparent;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: #DEE2E6;
    color: #4b5563;
    padding: 6px 20px 6px 12px;
    border: 1px solid #B8BEC6;
    border-bottom: 2px solid transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 0px;
    font-size: 9pt;
    font-weight: 500;
}
QTabBar::tab:selected {
    background: #E2E8F0;
    color: #111827;
    border: 1px solid #B8BEC6;
    border-bottom: 2px solid #60A5FA;
    font-weight: 500;
}
QTabBar::tab:hover:!selected {
    background: #ECEFF3;
}
#output_tabs::pane { 
    border: none;
    border-top: 1px solid #C9CFD8;
    background: #FFFFFF;
}
#output_tabs QTabBar::tab {
    background: #EAEFF5;
    color: #475569;
    padding: 2px 8px 2px 8px;
    height: 20px;
    border: 1px solid #CBD5E1;
    border-bottom: 1px solid #CBD5E1;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    font-size: 8.5pt;
    font-weight: 500;
}
#output_tabs QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-bottom: 1px solid #FFFFFF;
    margin-bottom: -1px;
    font-weight: 600;
}
#output_tabs QTabBar::tab:hover:!selected {
    background: #F1F5F9;
    color: #1E293B;
}
QTabBar::close-button {
    image: url(assets/close.svg);
    subcontrol-origin: padding;
    subcontrol-position: right center;
    margin-right: 6px;
    width: 16px;
    height: 16px;
    border: 1px solid transparent;
    border-radius: 4px;
    background-color: transparent;
}
QTabBar::close-button:hover {
    image: url(assets/close_hover.svg);
    background-color: #e8e8e8;
    border: 1px solid #9c9c9c;
    border-radius: 4px;
}
QTabBar::close-button:pressed {
    background-color: #dcdcdc;
    border: 1px solid #707070;
    border-radius: 4px;
}
/* Dialog and Input Styles */
#objectExplorerHeader {
    background-color: #E4E8ED;
    border-bottom: 1px solid #D3D8DF;
}
#objectExplorerLabel {
    color: #1f2937; 
    font-weight: bold; 
    font-size: 11px;
}
.sidebar-tool-btn {
    border: none;
    border-radius: 4px;
    background-color: transparent;
}
.sidebar-tool-btn:hover {
    background-color: #C9CFD8;
}
.sidebar-tool-btn:pressed {
    background-color: #B8BEC6;
}
#connectionTree { 
    border: none; 
    margin: 0; 
    padding: 0; 
    background-color: white; 
    font-size: 12px;
}
#schemaTreeHeader::section {
    background-color: #E4E8ED;
    color: #1f2937;
    font-weight: bold;
    font-size: 11px;
    padding: 3px 8px;
    border: none;
    border-bottom: 1px solid #D3D8DF;
    border-right: 1px solid #E4E8ED;
}
#schemaTreeHeader::section:last {
    border-right: none;
}
QDialog {
    background-color: #f6f8fb;
}
/* Property Panel Styles */
QFrame#propertyCard { background-color: white; border: 1px solid #e5e7eb; border-radius: 8px; margin-bottom: 12px; }
QLabel#cardHeader {
    background-color: #f3f4f6; color: #111827; font-weight: 600; font-size: 10pt;
    padding: 8px 12px; border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom: 1px solid #e5e7eb;
}
QLabel#cardHeader[active="true"] { background-color: #e0f2fe; color: #0369a1; border-bottom: 1px solid #bae6fd; }

QTableView#propertyTable {
    border: none;
    background-color: white;
    alternate-background-color: #fafafa;
    outline: none;
    font-size: 13px;
    color: #262626;
}
QTableView#propertyTable::item {
    padding: 4px 12px;
    border-bottom: 1px solid #f0f0f0;
}
QTableView#propertyTable::item:selected {
    background-color: #e6f4ff;
    color: #262626;
}
QTableView#propertyTable::item:hover:!selected {
    background-color: #f5f5f5;
}
QTableView#propertyTable QHeaderView::section {
    background-color: #fafafa;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #d9d9d9;
    border-right: 1px solid #f0f0f0;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #595959;
}
QTableView#propertyTable::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #d9d9d9;
    border-radius: 3px;
    background-color: white;
    margin-left: 6px;
}
QTableView#propertyTable::indicator:checked {
    background-color: #1677ff;
    border-color: #1677ff;
}
QLabel#dialogTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1f2937;
}
QLabel#dialogSubtitle {
    color: #6b7280;
    margin-bottom: 8px;
}
QLineEdit, QComboBox {
    min-height: 26px;
    border: 1px solid #c4c9d4;
    border-radius: 4px;
    background: white;
    padding: 3px 8px;
    color: #1f2937;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #0078d4;
    background-color: #ffffff;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(assets/toolbar-chevron-down.svg);
    width: 10px; height: 10px;
}
QComboBox {
    padding-right: 25px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2937;
    selection-background-color: #DDE2E8;
    selection-color: #1f2937;
    border: 1px solid #B8BEC6;
    outline: none;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    color: #1f2937;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #EEF1F6;
    color: #1f2937;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #DDE2E8;
    color: #1f2937;
}

QToolTip { 
    background-color: #FFFFFF; 
    color: #000000; 
    border: 1px solid #CCCCCC;
    padding: 4px 8px; 
    font-size: 11px; 
    opacity: 255;
}

/* ERD Styles */
PropertyPanel {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
}
.panel-header {
    font-size: 14px;
    font-weight: bold;
    padding: 12px;
    background-color: transparent;
    border-bottom: 1px solid #e5e7eb;
}
PropertyPanel QPushButton {
    padding: 6px 12px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background-color: #ffffff;
    font-weight: 500;
}
PropertyPanel QPushButton:hover {
    background-color: #f3f4f6;
}
PropertyPanel QPushButton:pressed {
    background-color: #e5e7eb;
}
.erd-type-label {
    color: #70757A;
}

ElementTile {
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    background: #FFFFFF;
    padding: 0px;
}
ElementTile:hover {
    background: #EEF2FF;
    border-color: #818CF8;
}
ElementTile:pressed {
    background: #E0E7FF;
}

ERDPalette {
    background-color: #F8FAFC;
    border-right: 1px solid #E2E8F0;
}
QPushButton#headerBtn {
    text-align: left;
    font-weight: bold;
    font-size: 12px;
    padding: 0px 8px;
    color: #1E293B;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    background: #F1F5F9;
    border-radius: 0px;
}
QPushButton#headerBtn:hover { background: #E2E8F0; }

QSpinBox {
    min-height: 28px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: white;
    padding-left: 6px;
    padding-right: 20px;
}
QSpinBox:focus {
    border: 1px solid #0078d4;
}

/* Custom QTreeView Branches */
QTreeView::branch:has-children:closed {
    border-image: none;
    image: url(assets/tree-chevron-right.svg);
}

QTreeView::branch:has-children:open {
    border-image: none;
    image: url(assets/tree-chevron-down.svg);
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:selected, QTreeView::branch:selected:active, QTreeView::branch:selected:!active {
    background-color: #f0f0f0;
}

/* Splash Screen Styles */
QLabel#splashTitle { 
    color: #202124; 
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif; 
    font-size: 32px; 
    font-weight: 600; 
    background: transparent; 
}
QLabel#splashSubtitle { 
    color: #5F6368; 
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif; 
    font-size: 16px; 
    background: transparent; 
}
QLabel#splashStatus { 
    color: #5F6368; 
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif; 
    font-size: 13px; 
    background: transparent; 
}
QLabel#splashVersion { 
    color: #9AA0A6; 
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif; 
    font-size: 12px; 
    background: transparent; 
}
QLabel#splashCopyright { 
    color: #9AA0A6; 
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif; 
    font-size: 11px; 
    background: transparent; 
}

/* Login Dialog Styles */
QLabel#loginAppName {
    color: #202124;
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
QLabel#loginHeading {
    color: #202124;
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: 600;
    background: transparent;
}
QLabel#loginSubheading {
    color: #5F6368;
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 14px;
    background: transparent;
}
QLineEdit#loginInput {
    min-height: 44px;
    border: 1px solid #DADCE0;
    border-radius: 4px;
    background: #FFFFFF;
    color: #202124;
    font-size: 14px;
    padding-left: 12px;
    padding-right: 12px;
}
QLineEdit#loginInput:focus {
    border: 1px solid #1A73E8;
    background: #FFFFFF;
}
QToolButton#loginEyeBtn {
    background: transparent;
    border: none;
}
QToolButton#loginEyeBtn:hover {
    background: #F1F3F4;
    border-radius: 4px;
}
QPushButton#loginPrimaryBtn {
    background-color: #1A73E8;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#loginPrimaryBtn:hover {
    background-color: #1765CC;
}
QPushButton#loginPrimaryBtn:pressed {
    background-color: #1558B0;
}
QPushButton#loginSkipBtn {
    color: #1A73E8;
    background: transparent;
    border: none;
    font-size: 13px;
}
QPushButton#loginSkipBtn:hover {
    text-decoration: underline;
}

/* ── Toad AI Chat Panel ───────────────────────────── */
QWidget#aiChatPanel {
    background-color: #ffffff;
    border-left: 1px solid #D1D6DD;
}
QWidget#aiChatHeader {
    background-color: #ECEFF3;
    border-bottom: 1px solid #D1D6DD;
}
QFrame#aiChatChipFrame {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}
QTextBrowser#aiChatBrowser {
    border: none;
    background-color: #ffffff;
}
QWidget#aiChatBottomContainer {
    background-color: #F8FAFC;
    border-top: 1px solid #D1D6DD;
}
QFrame#aiChatInputBorder {
    border: 1px solid #B8BEC6;
    border-radius: 4px;
    background-color: #ffffff;
}
QFrame#aiChatInputBorder:focus-within {
    border: 1px solid #0066CC;
}


/* ── Unified Connection Dialog & Launcher ─────────────────── */
QDialog#unifiedConnDialog {
    background-color: #FFFFFF;
}

#launcherSearchFrame {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 16px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
}
#launcherSearchFrame:hover {
    border: 1px solid #93C5FD;
}
#launcherSearchFrame[focused="true"],
#launcherSearchFrame[focused="true"]:hover {
    border: 1px solid #93C5FD;
    background-color: #FFFFFF;
}

#launcherSearchEdit,
#launcherSearchEdit:focus,
QDialog#unifiedConnDialog #launcherSearchEdit,
QDialog#unifiedConnDialog #launcherSearchEdit:focus {
    border: none;
    outline: none;
    background: transparent;
    font-size: 13px;
    color: #1E293B;
    padding: 0px;
    min-height: 22px;
    max-height: 26px;
}

#launcherSectionHeader {
    color: #64748B;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

#launcherHeaderLine {
    color: #E2E8F0;
    background-color: #E2E8F0;
    border: none;
    max-height: 1px;
}

#launcherScrollArea,
#launcherScrollArea > QWidget > QWidget,
#launcherScrollContent,
#launcherGridWidget {
    background: transparent;
    border: none;
}

#engineCard {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 0px;
}
#engineCard:hover {
    border: 1px solid #93C5FD;
    background-color: #F8FAFC;
}
#engineCard:pressed {
    border: 1.5px solid #1D4ED8;
    background-color: #DBEAFE;
}
#engineCard[selected="true"] {
    border: 1.5px solid #2563EB;
    background-color: #EFF6FF;
}
#engineCard[selected="true"]:hover {
    border: 1.5px solid #1D4ED8;
    background-color: #DBEAFE;
}

#engineCardTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
}

#engineCardSubtitle {
    font-size: 11px;
    color: #64748B;
}

/* Master-Detail Config View */
#configSidebar {
    background-color: #F8FAFC;
    border-right: 1px solid #E2E8F0;
    width: 215px;
    min-width: 215px;
    max-width: 215px;
}

#configSidebarBackBtn {
    background: transparent;
    border: none;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    padding: 8px 10px;
    border-radius: 6px;
}
#configSidebarBackBtn:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}

#configSidebarItem {
    background: transparent;
    border: 1px solid transparent;
    border-left: 2px solid transparent;
    border-radius: 6px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    color: #374151;
    padding: 6px 10px 6px 9px;
    margin: 1px 0px;
}
#configSidebarItem:hover {
    background-color: #F3F4F6;
    color: #111827;
    font-weight: 500;
}
#configSidebarItem:pressed {
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-left: 2px solid #BFDBFE;
    color: #1D4ED8;
    font-weight: 500;
    padding: 6px 10px 6px 9px;
}
#configSidebarItem[active="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-left: 2px solid #0284C7;
    border-radius: 6px;
    color: #0F172A;
    font-weight: 500;
}
#configSidebarItem[active="true"]:hover {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-left: 2px solid #0284C7;
    border-radius: 6px;
    color: #0F172A;
    font-weight: 500;
}
#configSidebarItem:focus,
#configSidebarItem[active="true"]:focus {
    outline: none;
}

#configRightContainer,
#configFormScroll,
#configFormScroll > QWidget > QWidget,
#configFormsStack,
BaseEngineForm,
OracleEngineForm,
PostgresEngineForm,
SQLiteEngineForm,
ServiceNowEngineForm,
CSVEngineForm {
    background-color: #FFFFFF;
}

#formTopHeader {
    background-color: #FFFFFF;
}

#formHeaderTitle {
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
}

#formHeaderSubtitle {
    font-size: 12px;
    color: #64748B;
}

#formSectionHeaderContainer {
    background-color: #FFFFFF;
}

#configStaticSectionHeader,
#formSectionHeader {
    font-size: 11px;
    font-weight: 700;
    color: #64748B;
    letter-spacing: 0.6px;
}

#formSectionLine {
    color: #E2E8F0;
    background-color: #E2E8F0;
    border: none;
    max-height: 1px;
}

#formFieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #1E293B;
}

/* Unified & Standalone Connection Dialog input & label polish */
QDialog#unifiedConnDialog,
QDialog#standaloneConnDialog {
    background-color: #FFFFFF;
}

QDialog#unifiedConnDialog QLineEdit,
QDialog#unifiedConnDialog QComboBox,
QDialog#standaloneConnDialog QLineEdit,
QDialog#standaloneConnDialog QComboBox {
    min-height: 28px;
    max-height: 28px;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    background-color: #FFFFFF;
    padding: 2px 10px;
    font-size: 12px;
    color: #1E293B;
}
QDialog#unifiedConnDialog QLineEdit:hover,
QDialog#unifiedConnDialog QComboBox:hover,
QDialog#standaloneConnDialog QLineEdit:hover,
QDialog#standaloneConnDialog QComboBox:hover {
    border: 1px solid #94A3B8;
}
QDialog#unifiedConnDialog QLineEdit:focus,
QDialog#unifiedConnDialog QComboBox:focus,
QDialog#standaloneConnDialog QLineEdit:focus,
QDialog#standaloneConnDialog QComboBox:focus {
    border: 1px solid #64748B;
    background-color: #FFFFFF;
    outline: none;
}

QDialog#unifiedConnDialog QComboBox QAbstractItemView,
QDialog#standaloneConnDialog QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #111827;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
    border: 1px solid #CBD5E1;
    border-radius: 0px;
    padding: 2px;
    outline: none;
}
QDialog#unifiedConnDialog QComboBox QAbstractItemView::item,
QDialog#standaloneConnDialog QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 8px;
    color: #111827;
    background-color: #FFFFFF;
    border-radius: 4px;
}
QDialog#unifiedConnDialog QComboBox QAbstractItemView::item:hover,
QDialog#standaloneConnDialog QComboBox QAbstractItemView::item:hover {
    background-color: #F3F4F6;
    color: #111827;
}
QDialog#unifiedConnDialog QComboBox QAbstractItemView::item:selected,
QDialog#standaloneConnDialog QComboBox QAbstractItemView::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

QDialog#unifiedConnDialog QLabel,
QDialog#standaloneConnDialog QLabel {
    font-size: 12px;
    color: #374151;
}

QDialog#unifiedConnDialog QRadioButton,
QDialog#standaloneConnDialog QRadioButton {
    spacing: 7px;
    font-size: 12px;
    color: #1F2937;
}
QDialog#unifiedConnDialog QRadioButton::indicator,
QDialog#standaloneConnDialog QRadioButton::indicator {
    width: 16px;
    height: 16px;
    image: url(assets/radio-unchecked.svg);
}
QDialog#unifiedConnDialog QRadioButton::indicator:hover,
QDialog#standaloneConnDialog QRadioButton::indicator:hover {
    image: url(assets/radio-unchecked-hover.svg);
}
QDialog#unifiedConnDialog QRadioButton::indicator:checked,
QDialog#standaloneConnDialog QRadioButton::indicator:checked {
    image: url(assets/radio-checked.svg);
}

QDialog#unifiedConnDialog QScrollBar:vertical,
QDialog#standaloneConnDialog QScrollBar:vertical,
QDialog#baseConnectionDialog QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}
QDialog#unifiedConnDialog QScrollBar::handle:vertical,
QDialog#standaloneConnDialog QScrollBar::handle:vertical,
QDialog#baseConnectionDialog QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 24px;
    border-radius: 3px;
}
QDialog#unifiedConnDialog QScrollBar::handle:vertical:hover,
QDialog#standaloneConnDialog QScrollBar::handle:vertical:hover,
QDialog#baseConnectionDialog QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QDialog#unifiedConnDialog QScrollBar::add-line:vertical,
QDialog#unifiedConnDialog QScrollBar::sub-line:vertical,
QDialog#standaloneConnDialog QScrollBar::add-line:vertical,
QDialog#standaloneConnDialog QScrollBar::sub-line:vertical,
QDialog#baseConnectionDialog QScrollBar::add-line:vertical,
QDialog#baseConnectionDialog QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}
QDialog#unifiedConnDialog QScrollBar::add-page:vertical,
QDialog#unifiedConnDialog QScrollBar::sub-page:vertical,
QDialog#standaloneConnDialog QScrollBar::add-page:vertical,
QDialog#standaloneConnDialog QScrollBar::sub-page:vertical,
QDialog#baseConnectionDialog QScrollBar::add-page:vertical,
QDialog#baseConnectionDialog QScrollBar::sub-page:vertical {
    background: transparent;
}

QDialog QScrollArea#dialogScrollArea {
    background: transparent;
    border: none;
}

QDialog QWidget#dialogFormWidget {
    background: transparent;
}



